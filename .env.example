# Copia este archivo a `.env` y rellena los valores. No subas `.env` al repositorio.

# --- OpenAI (LLM del chatbot) ---
# Obtén una clave en: https://platform.openai.com/api-keys
# Crea una clave nueva en tu cuenta de OpenAI (requiere registro y método de pago según el plan).
OPENAI_API_KEY=sk-proj-000000000000000000000000000000000000000000000000

# --- Servidor API (FastAPI / Uvicorn) ---
# Puerto HTTP local donde escucha el backend. Ajusta si ya está en uso (p. ej. 8080).
# En despliegue, muchas plataformas inyectan PORT automáticamente; aquí defines el valor por defecto en local.
PORT=8000

# --- CORS: origen del frontend ---
# URL base desde la que el navegador llama a la API (sin barra final). Debe coincidir con el origen real
# de tu app web (esquema + host + puerto), p. ej. http://localhost:5173 (Vite) o http://localhost:3000.
# Si usas varios orígenes, documenta en README cómo separarlos o usa una variable lista en código.
FRONTEND_URL=http://localhost:3000

# --- RAG: fuente de conocimiento ---
# URL del índice o API desde la que se cargan o consultan los documentos del RAG (protocolos, FAQs de la clínica).
# Ejemplos según tu stack: endpoint de un vector store administrado, URL base de una API de búsqueda,
# o ruta de un servicio interno. Sustituye por la URL real de tu proveedor o despliegue.
RAG_SOURCE_URL=https://example.invalid/vet-clinic-rag/v1
