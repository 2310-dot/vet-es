# Copia este archivo a `.env` y rellena los valores. No subas `.env` al repositorio.

# --- OpenAI (LLM del chatbot) ---
# La clave no debe estar en código ni en el frontend: solo aquí / variables del despliegue.
# Obtén una clave en: https://platform.openai.com/api-keys
# Crea una clave nueva en tu cuenta de OpenAI (requiere registro y método de pago según el plan).
OPENAI_API_KEY=sk-proj-000000000000000000000000000000000000000000000000
# Instrucciones de sistema del asistente: archivo prompt.md en la raíz del repo (carga el backend).
# Puntero documentado en código: llm_service.SYSTEM_PROMPT_SOURCE_REF (material ENAE + prompt.md).
# Modelo de chat (opcional). Por defecto en código: gpt-4o-mini.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Solo en local / depuración: si el chat devuelve 502, pon 1 para ver el error real en JSON (no uses en producción).
# LLM_DEBUG_ERRORS=0

# --- Servidor API (FastAPI / Uvicorn) ---
# Puerto HTTP local donde escucha el backend. Ajusta si ya está en uso (p. ej. 8080).
# En despliegue, muchas plataformas inyectan PORT automáticamente; aquí defines el valor por defecto en local.
PORT=8000

# --- CORS: origen del frontend ---
# URL base desde la que el navegador llama a la API (sin barra final). Debe coincidir con el origen real
# de tu app web (esquema + host + puerto), p. ej. http://localhost:5173 (Vite) o http://localhost:3000.
# Si usas varios orígenes, documenta en README cómo separarlos o usa una variable lista en código.
FRONTEND_URL=http://localhost:3000

# --- Demo de chat en navegador (VE-19): URL base del API en el cliente ---
# El HTML estático no lee .env. La base URL que usa el JS del chat está en
# static/chat_config.js → window.CHATBOT_API_BASE ("" = mismo origen que la página).

# --- CORS (FastAPI): orígenes permitidos para el demo de chat (VE-19) ---
# Lista separada por comas. Solo se activa CORS si esta variable no está vacía.
# Ejemplo si sirves el HTML desde otro host/puerto que el de la API:
# CORS_ALLOW_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- RAG: fuente de conocimiento ---
# URL del índice o API desde la que se cargan o consultan los documentos del RAG (protocolos, FAQs de la clínica).
# Ejemplos según tu stack: endpoint de un vector store administrado, URL base de una API de búsqueda,
# o ruta de un servicio interno. Sustituye por la URL real de tu proveedor o despliegue.
RAG_SOURCE_URL=https://example.invalid/vet-clinic-rag/v1

# --- RAG preoperatorio (VE-22): demo opcional ---
# Sustituye la URL canónica sin tocar código (p. ej. entorno de staging).
# PREOP_RAG_LIVE_URL=https://veterinary-clinic-teal.vercel.app/en/docs/instructions-before-operation
# Prueba pytest con red real + embeddings OpenAI: RUN_PREOP_RAG_LIVE=1 pytest -m preop_live

# --- Memoria de conversación por sesión (VE-21, en proceso / sin persistencia) ---
# Máximo de pares usuario→asistente guardados por session_id (tras strip). Más antiguos se descartan.
CHAT_MEMORY_MAX_TURNS=50
# TTL en segundos desde el último mensaje (time.monotonic). 0 = desactivado: vive mientras el proceso.
# Reiniciar el servidor borra toda la memoria. Claves case-sensitive; solo se hace strip al session_id.
CHAT_MEMORY_TTL_SECONDS=0

# --- Google Calendar (VE-24): read-only listing tool ---
# OAuth scope used in code: https://www.googleapis.com/auth/calendar.readonly
# Create an OAuth client (Desktop app) in Google Cloud Console, run a one-time
# OAuth flow to obtain a refresh token, then set the variables below. Never
# commit real tokens or client secrets.
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional: HTTP timeout in seconds for Calendar API calls (default 30).
# GOOGLE_CALENDAR_HTTP_TIMEOUT_SECONDS=30
# Tests / offline runs without Google: set to 1 to return an empty stub payload.
# GOOGLE_CALENDAR_USE_STUB=0
